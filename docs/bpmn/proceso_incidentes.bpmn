<bpmndi:BPMNShape id="DI_Gateway_Conforme" bpmnElement="Gateway_Conforme"><dc:Bounds x="1670" y="188" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="DI_Task_Cerrar" bpmnElement="Task_Cerrar"><dc:Bounds x="1810" y="175" width="135" height="76"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="DI_EndEvent_1" bpmnElement="EndEvent_1"><dc:Bounds x="2010" y="195" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="DI_Flow_1" bpmnElement="Flow_1"><di:waypoint x="246" y="213"/><di:waypoint x="310" y="213"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="DI_Flow_2" bpmnElement="Flow_2"><di:waypoint x="435" y="213"/><di:waypoint x="495" y="213"/></bpmndi:BPMNEdge>
