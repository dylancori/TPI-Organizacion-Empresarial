<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_TechLogix" targetNamespace="https://techlogix.example/academico">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Usuario" name="Usuario / Cliente" />
    <bpmn:participant id="Participant_TechLogix" name="TechLogix Solutions" processRef="Process_Incidentes"/>
    <bpmn:messageFlow id="MessageFlow_Reporte" sourceRef="Participant_Usuario" targetRef="StartEvent_1" />
    <bpmn:messageFlow id="MessageFlow_Respuesta" sourceRef="Task_Notificar" targetRef="Participant_Usuario" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Incidentes" name="Resolución de incidentes y mejora QA/CI-CD" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_N1" name="Mesa de Ayuda (N1)"><bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Registrar</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_N1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ResolverN1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Notificar</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Conforme</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Cerrar</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_N2" name="Soporte especializado (N2)"><bpmn:flowNodeRef>Task_Escalar</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Corregir</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_QA" name="Calidad y CI/CD"><bpmn:flowNodeRef>Task_Pruebas</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Pruebas</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Incidente reportado"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_Registrar" name="Registrar y diagnosticar ticket"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_N1" name="¿Resuelve N1?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_ResolverN1" name="Aplicar solución conocida"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Escalar" name="Escalar con diagnóstico a N2"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Corregir" name="Reproducir y corregir defecto"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Pruebas" name="Ejecutar QA y pipeline CI/CD"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Pruebas" name="¿Pruebas OK?"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Notificar" name="Notificar solución al usuario"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Conforme" name="¿Usuario conforme?"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Cerrar" name="Cerrar ticket y documentar aprendizaje"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Ticket cerrado"><bpmn:incoming>Flow_14</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Registrar"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Registrar" targetRef="Gateway_N1"/>
    <bpmn:sequenceFlow id="Flow_3" name="Sí" sourceRef="Gateway_N1" targetRef="Task_ResolverN1"/>
    <bpmn:sequenceFlow id="Flow_4" name="No" sourceRef="Gateway_N1" targetRef="Task_Escalar"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ResolverN1" targetRef="Task_Notificar"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Escalar" targetRef="Task_Corregir"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Corregir" targetRef="Task_Pruebas"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Pruebas" targetRef="Gateway_Pruebas"/>
    <bpmn:sequenceFlow id="Flow_9" name="No" sourceRef="Gateway_Pruebas" targetRef="Task_Corregir"/>
    <bpmn:sequenceFlow id="Flow_10" name="Sí" sourceRef="Gateway_Pruebas" targetRef="Task_Notificar"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Notificar" targetRef="Gateway_Conforme"/>
    <bpmn:sequenceFlow id="Flow_12" name="Sí" sourceRef="Gateway_Conforme" targetRef="Task_Cerrar"/>
    <bpmn:sequenceFlow id="Flow_13" name="No, reabrir" sourceRef="Gateway_Conforme" targetRef="Task_Registrar"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Cerrar" targetRef="EndEvent_1"/>
  </bpmn:process>
<bpmndi:BPMNDiagram id="BPMNDiagram_TechLogix"><bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
<bpmndi:BPMNShape id="DI_Participant_Usuario" bpmnElement="Participant_Usuario" isHorizontal="true"><dc:Bounds x="100" y="30" width="1980" height="90"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="DI_Participant_TechLogix" bpmnElement="Participant_TechLogix" isHorizontal="true"><dc:Bounds x="100" y="130" width="1980" height="510"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="DI_Lane_N1" bpmnElement="Lane_N1" isHorizontal="true"><dc:Bounds x="130" y="130" width="1950" height="170"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="DI_Lane_N2" bpmnElement="Lane_N2" isHorizontal="true"><dc:Bounds x="130" y="300" width="1950" height="170"/></bpmndi:BPMNShape>
